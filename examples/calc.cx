let a: float = input("Enter number one: ")
let b: float = input("Enter number two: ")
let op: byte = input("Eneter Operator: ")

safeDiv(a: float, b: float): unit {
    if b == 0.0 then println("Can't divide by zero") else println(a / b)
}

match op with
    | '+' -> println(a + b)
    | '-' -> println(a - b)
    | '*' -> println(a * b)
    | '/' -> safeDiv(a, b)
    | _ -> println("Operator not supported")