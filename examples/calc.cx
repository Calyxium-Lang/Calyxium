let a: float = 10.0
let b: float = 5.0
let op: byte = '/'

safeDiv(a: float, b: float): unit {
    if b == 0.0 then println("Can't divide by zero") else println(a / b)
}

match op with
    | '+' -> println(a + b)
    | '-' -> println(a - b)
    | '*' -> println(a * b)
    | '/' -> safeDiv(a, b)
    | _ -> println("Operator not supported")