let a: float = input("Enter value a: ")
let b: float = input("Enter value b: ")
let op: byte = input("Enter operator: ")

let safeDiv(a: float, b: float): unit {
    if b == 0.0 then print("Can't divide by zero\n") else print(a / b)
}

match op with
    | '+' -> print(a + b)
    | '-' -> print(a - b)
    | '*' -> print(a * b)
    | '/' -> safeDiv(a, b)
    | _ -> print("Operator not supported")
