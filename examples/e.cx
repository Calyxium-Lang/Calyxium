let head(lst) {
    lst[0]
}

let tail(lst) {
    lst[1:]
}

let prepend(elem, lst) { 
    [elem] @ lst
}

let rec reverse(lst, acc) {
    if length(lst) == 0 then acc
    else reverse(tail(lst), prepend(head(lst), acc))
}

let array_to_float(int_array) {
    let rec convert(i, acc, arr) {
        if i >= length(arr) then reverse(acc, [])
        else {
            let f = to_float(arr[i]) in
            convert(i + 1, prepend(f, acc), arr)
        }
    }
    convert(0, [], int_array)
}

print(array_to_float([ 1, 2 ]) == [ 1.0, 2.0 ])