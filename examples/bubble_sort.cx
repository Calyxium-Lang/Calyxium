let bubble_sort(arr) {
    let rec pass(xs, i, acc, ch) {
        if i + 1 > length(xs) || i + 1 == length(xs) then (ch, reverse(acc) @ (if i < length(xs) then [ xs[i] ] else []))
        else {
            let a = xs[i] in
            let b = xs[i + 1] in
            if a > b then
                pass(xs, i + 2, [ a, b ] @ acc, true)
            else
                pass(xs, i + 1, [ a ] @ acc, ch)
        }
    }
    let rec sort(xs) {
        let ch, xs' = pass(xs, 0, [], false) in
        if ch then sort(xs') else xs'
    }
    sort(arr)
}

let arr = [ 5, 2, 9, 1, 3 ] in

let sorted = bubble_sort(arr) in

print(sorted)
