-- Id: tests/struct.cx

-- basic test for records

record Person = {
    let name = "John Doe" in
    let age = 30 in
}

assert(Person.name ^ "\n" == "John Doe\n")
assert(to_string(Person.age) ^ "\n" == "30\n")

record Car = {
    let make = "Tesla" in
    let model = "Model S" in
    let year = 2023 in
}

assert(Car.make ^ " " ^ Car.model ^ "\n" == "Tesla Model S\n")
assert(to_string(Car.year) ^ "\n" == "2023\n")


record Ascii = {
    let ascii_vals = [33, 34, 35] in
}

let ascii_str = to_string(to_byte(Ascii.ascii_vals)) in
assert(ascii_str == "!\"#")

record Config = {
    let debug = true in
    let max_connections = 100 in
    let version = "1.0.0" in
}

assert(to_string(Config.debug) == "true")
assert(to_string(Config.max_connections) == "100")
assert(Config.version == "1.0.0")

record Mixed = {
    let flag = false in
    let count = 42 in
    let message = "Hello" in
}

assert(to_string(Mixed.flag) == "false")
assert(to_string(Mixed.count) == "42")
assert(Mixed.message == "Hello")