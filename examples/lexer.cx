let source: string = "let x: int = 10"

enum Tokens {
    Let, Ident, IntType, Assign, IntLiteral, Colon
}

let is_alpha(c: byte): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

let is_digit(c: byte): bool {
    return (c >= '0' && c <= '9')
}

let is_whitespace(c: byte): bool {
    return c == ' ' || c == '\t' || c == '\n'
}

let starts_with(bytes: []byte, pos: int, prefix: string): bool {
    let prefix_bytes: []byte = to_bytes(prefix)
    let prefix_len: int = length(prefix_bytes)
    if (pos + prefix_len > length(bytes)) {
        return false
    }
    for (let i: int = 0; i < prefix_len; i++) {
        if (bytes[pos + i] != prefix_bytes[i]) {
            return false
        }
    }

    return true
}

let rec tokenize_at(i: int, bytes: []byte, tokens: []Tokens): []Tokens {
    if (i >= length(bytes)) {
        return tokens
    }

    let c: byte = bytes[i]

    if (is_whitespace(c)) {
        return tokenize_at(i + 1, bytes, tokens)
    }

    if (starts_with(bytes, i, "let")) {
        return tokenize_at(i + 3, bytes, { Tokens.Let })
    } 

    if (starts_with(bytes, i, "int")) {
        return tokenize_at(i + 3, bytes, { Tokens.IntType })
    }

    if (c == ':') {
        return tokenize_at(i + 1, bytes, { Tokens.Colon })
    }

     if (c == '=') {
        return tokenize_at(i + 1, bytes, { Tokens.Assign })
    }

    return tokenize_at(i + 1, bytes, tokens)
}

let tokenize(code: string): []Tokens {
    let bytes: []byte = to_bytes(code)
    return tokenize_at(0, bytes, {})
}

tokenize(source) |> println
