let rec set(xs, i, v) {
    if i == 0 then [v] @ tail(xs)
    else [head(xs)] @ set(tail(xs), i - 1, v)
}

let rec get(xs, i) {
    if i == 0 then head(xs)
    else get(tail(xs), i - 1)
}

let rec mark_multiples(xs, p, i, limit) {
    if i > limit then xs
    else {
        let xs' = set(xs, i, false) in
        mark_multiples(xs', p, i + p, limit)
    }
}

let rec sieve(xs, p, limit) {
    if p * p > limit then xs
    else if get(xs, p) then {
        let xs' = mark_multiples(xs, p, p * p, limit) in
        sieve(xs', p + 1, limit)
    } else
        sieve(xs, p + 1, limit)
}

let rec count_primes(xs, i, limit, acc) {
    if i > limit then acc
    else count_primes(xs, i + 1, limit, acc + (if get(xs, i) then 1 else 0))
}

let rec build_array(n, v) {
    if n == 0 then []
    else [v] @ build_array(n - 1, v)
}

let limit = 1000000 in
let arr = build_array(limit + 1, true) in
let arr1 = set(set(arr, 0, false), 1, false) in

let arr' = sieve(arr1, 2, limit) in
let total_primes = count_primes(arr', 2, limit, 0) in

print("Total primes up to 1,000,000: ")
print(total_primes)