-- Id: tests/pemdas.cx

-- basic order of operations test

assert(1 + 2 * 3 == 7)
assert((1 + 2) * 3 == 9)
assert(10 / 2 + 3 == 8)
assert(10 / (2 + 3) == 2)

assert(2 ** 3 == 8)
assert(2 ** 3 + 1 == 9)
assert(2 ** (3 + 1) == 16)

assert(-3 + 5 == 2)
assert(-(-3) == 3)
assert(5 == 5)

assert(10 % 3 == 1)
assert(5 % 5 == 0)

assert((1 << 2) + 3 == 7)
assert(1 << (2 + 1) == 8)
assert(~0 == -1)

let x = 5
x += 3
assert(x == 8)
x *= 2
assert(x == 16)

assert(((1 + 2) * (3 + 4)) / 7 == 3)