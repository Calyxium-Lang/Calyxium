-- Id: tests/not.cx

-- basic tests for not

assert(!true == false)
assert(!false == true)
assert(!(1 == 2) == true)
assert(!(1 < 2) == false)
assert(!(0 >= 0) == false)

let negate_eq(x: int, y: int): bool {
    !(x == y)
}

assert(negate_eq(1, 1) == false)
assert(negate_eq(1, 2) == true)

let logic(a: int): string {
    if !(a > 0) then "non-positive" else "positive"
}

assert(logic(0) == "non-positive")
assert(logic(-5) == "non-positive")
assert(logic(10) == "positive")

assert(!!true == true)
assert(!!false == false)
assert(!!!true == false)
assert(!!!!true == true)

assert(!(true && false) == true)
assert(!(true || false) == false)
assert(!((1 < 2) && (3 > 2)) == false)
assert(!((1 == 2) || (2 == 2)) == false)
assert(!((5 <= 10) && !(10 < 5)) == false)

let describe(x: int): string {
    if !(x == 0) then "non-zero" else "zero"
}

assert(describe(0) == "zero")
assert(describe(5) == "non-zero")
assert(describe(-1) == "non-zero")

let deep_not(b: bool): bool {
    !!!!b
}

assert(deep_not(true) == true)
assert(deep_not(false) == false)

let rec loop_count_inner(i: int, count: int): int {
    if i == 3 then count else loop_count_inner(i + 1, count + 1)
}

let loop_count(): int {
    loop_count_inner(0, 0)
}

assert(loop_count() == 3)