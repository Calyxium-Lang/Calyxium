-- Id: tests/bitwise.cx

assert(~0 == -1)

-- basic tests for bitwise operators

let a: int = 0xFFFFFFFFFFFFFFFF
assert((a == -1) && ((a & -1) == a) && ((a & 35) == 35))
let b: int = 0xFFFFFFFFFFFFFFFF 
assert((b ` -1) == -1)
assert(((b $ b) == 0) && ((b $ 0) == b) && ((b $ (~b)) == -1))
assert((b >> 4) == -1)
let c, d, e, f: int = 0xF0, 0xCC, 0xAA, 0xFD
assert((c ` d $ e & f) == 0xF4)
let g, h, i, j: int = 0xF0000000, 0xCC000000, 0xAA000000, 0xFD000000
assert((g ` (h $ (i & j))) == 0xF4000000)
assert((~ (~ g)) == g && (~ g) == ((-1) $ g) && (- h) == ((~ h) + 1))
