let a = [1..5] in
let b = [6, 7, 8] in
let c = a @ b in

assert(a[0:2] == [1, 2])
assert(a[2:5] == [3, 4, 5])
assert(b[1:] == [7, 8])
assert(c[:3] == [1, 2, 3])
assert(c[3:7] == [4, 5, 6, 7])

assert(a[3:] == [4, 5])
assert(b[:2] == [6, 7])
assert(c[:] == [1..8])

assert(a[2:2] == [])
assert(b[3:3] == [])
assert(c[8:8] == [])

assert(a[5:10] == [])
assert(b[-5:-1] == [])
assert(c[10:20] == [])
assert(c[-10:-6] == [])

assert(a[-2:2] == [1, 2])
assert(a[-3:4] == [1, 2, 3, 4])

let d = a[1:4] @ b[:2] in
assert(d == [2, 3, 4, 6, 7])

let e = a[:] @ [] in
assert(e == a)

let f = [] @ b[:1] in
assert(f == [6])

let g = a[0:0] @ b[0:0] in
assert(g == [])

let i = (a[:3])[1:] in
assert(i == [2, 3])
assert(a[0:1] == [1])
assert(b[2:3] == [8])
assert(c[7:8] == [8])
assert(a[-10:] == a)
assert((a[2:4] @ []) == [3, 4])
assert(([] @ b[0:2]) == [6, 7])
assert(([] @ []) == [])
assert(a[4:2] == [])
assert(a[10:11] == [])
assert(a[-1:-3] == [])