-- $Id: tests/strings.cx $

-- $ basic operations for string $
let a, b: string = "Hello", "world"

let c: string = a ^ " " ^ b
assert(c == "Hello world")

let len: int = length(c)
assert(len == 11)

let c_byte: []byte = to_bytes(c)
let first: byte = c_byte[0]
assert(first == 'H')

let same: bool = "test" == "test"
let diff: bool = "foo" != "bar"
assert(same)
assert(diff)

let esc: string = "line1\nline2"
assert(length(esc) == 11)

let n: int = 5
let interp: string = "number is " ^ to_string(n)
assert(interp == "number is 5")

let empty: string = ""
assert(length(empty) == 0)
let concat: string = "foo" ^ "bar" ^ "baz"
assert(concat == "foobarbaz")
