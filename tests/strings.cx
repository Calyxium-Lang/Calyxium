-- Id: tests/strings.cx

-- basic operations for string

let a, b = "Hello", "world"

let c = a ^ " " ^ b
assert(c == "Hello world")

let len = length(c)
assert(len == 11)

let c_byte = to_bytes(c)
let first = c_byte[0]
assert(first == 'H')

let same = "test" == "test"
let diff = "foo" != "bar"
assert(same)
assert(diff)

let esc = "line1\nline2"
assert(length(esc) == 11)

let n = 5
let interp = "number is " ^ to_string(n)
assert(interp == "number is 5")

let empty = ""
assert(length(empty) == 0)

let concat = "foo" ^ "bar" ^ "baz"
assert(concat == "foobarbaz")
