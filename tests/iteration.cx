-- $Id: tests/iteration.cx $

-- $ basic tests for iteration operations $
let acc: int = 0
for (let i: int = 1; i <= 5; i++) {
    acc += i
}

assert(acc == 15)

let total: int = 0
for (let i: int = 1; i <= 3; i++) {
    for (let j: int = 1; j <= 2; j++) {
        total += (i * j)
    }
}

assert(total == 18)

let sum: int = 0
for (let i: int = 10; i < 10; i++) {
    sum += i
}

assert(sum == 0)

let down: int = 0
for (let i: int = 5; i >= 1; i--) {
    down += i
}

assert(down == 15)

let sum2: int = 0
for (let i: int = 1; i <= 5; i += 2) {
    sum2 += i
}

assert(sum2 == 9)

let arr: []int = {1, 2, 3, 4, 5}
let arr_sum: int = 0
for (let i: int = 0; i < length(arr); i++) {
    arr_sum += arr[i]
}
assert(arr_sum == 15)