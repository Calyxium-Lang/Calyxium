-- $Id: tests/pm.cx $

-- $ basic tests for pattern matching $
enum Colors {
    Red, Blue, Green
}

let c: Colors = Colors.Green

let result(): string {
    match c with
        | Colors.Red -> "Red"
        | Colors.Blue -> "Blue"
        | Colors.Green -> "Green"
        | _ -> "Error"
}

assert(result() == "Green")

let numbers(n: int): string {
    match n with
        | 0 -> "zero"
        | 1 -> "one"
        | _ -> "many"
}

assert(numbers(0) == "zero")
assert(numbers(32) == "many")

let pair(p: (int, int)): string {
    match p with
        | (0, 0) -> "origin"
        | _ -> "somewhere" 
}

assert(pair((0, 0)) == "origin")
assert(pair((1, 2)) == "somewhere")

let parity(n: int): string {
    match n % 2 with
        | 0 -> "even"
        | _ -> "odd"
}

assert(parity(4) == "even")
assert(parity(5) == "odd")

let check(n: int): string {
    if n > 10 then
        match n with
            | 42 -> "magic"
            | _ -> "big"
    else "small"
}

assert(check(5) == "small")
assert(check(42) == "magic")
assert(check(20) == "big")

enum Light {
    Red, Yellow, Green
}

let describe_light(l: Light): string {
    match l with
        | Light.Red -> "stop"
        | Light.Green -> "go"
        | _ -> match l with
            | Light.Yellow -> "slow"
            | _ -> "unknown"
}

assert(describe_light(Light.Red) == "stop")
assert(describe_light(Light.Yellow) == "slow")

let sign(n: int): string {
    if n > 0 then "positive" else "non-positive"
}

assert(sign(5) == "positive")
assert(sign(0) == "non-positive")
assert(sign(-3) == "non-positive")

let nested(n: int): string {
    if n > 0 then
        if n > 10 then "big positive" else "small positive" 
    else "non-positive"
}

assert(nested(5) == "small positive")
assert(nested(20) == "big positive")
assert(nested(0) == "non-positive")

let fancy(n: int): string {
    if n < 0 then "negative" else match n with
        | 0 -> "zero"
        | _ -> "positive"
}

assert(fancy(-1) == "negative")
assert(fancy(0) == "zero")
assert(fancy(5) == "positive")

let complex_match(x: (int, string)): string {
    match x with
        | (0, "zero") -> "zero pair"
        | (1, "one") -> "one pair"
        | _ -> "other pair"
}

assert(complex_match((0, "zero")) == "zero pair")
assert(complex_match((1, "one")) == "one pair")
assert(complex_match((2, "two")) == "other pair")

let nested_match(x: (int, (string, bool))): string {
    match x with
        | (0, ("zero", true)) -> "zero true"
        | (1, ("one", false)) -> "one false"
        | _ -> "other"
}

assert(nested_match((0, ("zero", true))) == "zero true")
assert(nested_match((1, ("one", false))) == "one false")
assert(nested_match((2, ("two", true))) == "other")

let then_branch(n: int): string {
    if n > 0 then
        match n with
            | 1 -> "one"
            | 2 -> "two"
            | _ -> "many"
}

assert(then_branch(1) == "one")
assert(then_branch(2) == "two")
assert(then_branch(3) == "many")