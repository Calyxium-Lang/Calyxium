-- Id: tests/enum.cx

-- basic tests for enum

enum Week {
    Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
}

let week_names = [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" ]

let week_to_string(day: Week): string {
    week_names[day]
}

let tuesday_str = week_to_string(Week.Tuesday)

assert(tuesday_str == "Tuesday")