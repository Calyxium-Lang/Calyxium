-- Id: tests/tuples.cx

-- basic tests for tuples

let t1 = (1, 2)
let t2 = ("hello", 3.14, true)

let a, b = t1
assert(a == 1)
assert(b == 2)

let greet, pi, flag = t2
assert(greet == "hello")
assert(pi == 3.14)
assert(flag == true)

let pair(x: int, y: int): (int, int) {
    (x, y)
}

let px, py = pair(10, 20)
assert(px == 10)
assert(py == 20)

let deep = ((1, "a"), (true, 3.5))
let tp1, tp2 = deep
assert(tp1 == (1, "a"))
assert(tp2 == (true, 3.5))
assert(tp1[0] == 1)
assert(tp1[1] == "a")
assert(tp2[0] == true)
assert(tp2[1] == 3.5)

let nested_tuple = (42, ("nested", 2.718))
let n1, n2 = nested_tuple
assert(n1 == 42)
assert(n2 == ("nested", 2.718))

let complex = (1, ("test", (true, 1.23)))
let c1, c2 = complex
assert(c1 == 1)
assert(c2 == ("test", (true, 1.23)))

let if_return(x: int, y: int): (int, int) {
    if x == 0 then (1, 2) else (x, y)
}

let e1, e2 = if_return(5, 1)
assert(e1 == 5)
assert(e2 == 1)

let f1, f2 = if_return(0, 1)
assert(f1 == 1)
assert(f2 == 2)