-- $Id: tests/tuples.cx $

-- $ basic tests for tuples $
let t1: (int, int) = (1, 2)
let t2: (string, float, bool) = ("hello", 3.14, true)

let a, b: (int, int) = t1
assert(a == 1)
assert(b == 2)

let greet, pi, flag: (string, float, bool) = t2
assert(greet == "hello")
assert(pi == 3.14)
assert(flag == true)

let pair(x: int, y: int): (int, int) {
    return (x, y)
}

let px, py: (int, int) = pair(10, 20)
assert(px == 10)
assert(py == 20)

let deep: ((int, string), (bool, float)) = ((1, "a"), (true, 3.5))
let tp1, tp2: ((int, string), (bool, float)) = deep
assert(tp1 == (1, "a"))
assert(tp2 == (true, 3.5))
assert(tp1[0] == 1)
assert(tp1[1] == "a")
assert(tp2[0] == true)
assert(tp2[1] == 3.5)