-- Id: tests/math.cx

let pi = 3.141592653589 in
let e = 2.718281828459 in

let rec fact(n: int): float {
    if n <= 1 then 1.0 else to_float(n) * fact(n - 1)
}

let pow(base: float, exp: float): float {
    base ** exp
}

let abs(x: float): float {
    (x <= 0.0) ? -x : x
}

let degToRad(deg: float): float {
    deg * pi / 180.0
}

let radToDeg(rad: float): float {
    rad * 180.0 / pi
}

let rec sin_iter(x: float, n: int, terms: int, acc: float): float {
    if n >= terms then acc else {
        let sign = ((n % 2) == 0) ? 1.0 : -1.0 in
        let term = sign * pow(x, to_float(2 * n + 1)) / fact(2 * n + 1) in
        sin_iter(x, n + 1, terms, acc + term)
    }
}

let sin(x: float, terms: int): float {
    sin_iter(x, 0, terms, 0.0)
}

let csc(x: float, terms: int): float {
    1.0 / sin(x, terms)
}

let rec arcsin_iter(x: float, n: int, terms: int, acc: float): float {
    if n >= terms then acc else {
        let num = fact(2 * n) in
        let denom = pow(4.0, to_float(n)) * pow(fact(n), 2.0) * to_float(2 * n + 1) in
        let term = (num / denom) * pow(x, to_float(2 * n + 1)) in
        arcsin_iter(x, n + 1, terms, acc + term)
    }
}

let arcsin(x: float, terms: int): float {
    if (x < -1.0 || x > 1.0) then panic("Error: arcsin(x) is undefined for x < -1 or x > 1")
    let raw = arcsin_iter(x, 0, terms, 0.0) in
    (raw < -pi/2.0) ? -pi/2.0 : (raw > pi/2.0) ? pi/2.0 : raw
}

let rec cos_iter(x: float, n: int, terms: int, acc: float): float {
    if n >= terms then acc else {
        let sign = ((n % 2) == 0) ? 1.0 : -1.0 in
        let term = sign * pow(x, to_float(2 * n)) / fact(2 * n) in
        cos_iter(x, n + 1, terms, acc + term)
    }
}

let cos(x: float, terms: int): float {
    cos_iter(x, 0, terms, 0.0)
}

let sec(x: float, terms: int): float {
    1.0 / cos(x, terms)
}

let arccos(x: float, terms: int): float {
    if x == 1.0 then 0.0
    else if x == -1.0 then pi
    else pi / 2.0 - arcsin(x, terms)
}

let tan(x: float, terms: int): float {
    sin(x, terms) / cos(x, terms)
}

let cot(x: float, terms: int): float {
    cos(x, terms) / sin(x, terms)
}

let rec arctan_iter(x: float, n: int, terms: int, acc: float): float {
    if n >= terms then acc else {
        let term = pow(-1.0, to_float(n)) * pow(x, to_float(2 * n + 1)) / to_float(2 * n + 1) in
        arctan_iter(x, n + 1, terms, acc + term)
    }
}

let rec arctan(x: float, terms: int): float {
    if x == 1.0 then pi / 4.0
    else if x > 1.0 then pi / 2.0 - arctan(1.0 / x, terms)
    else if x < -1.0 then -pi / 2.0 - arctan(1.0 / x, terms)
    else arctan_iter(x, 0, terms, 0.0)
}

let wrapAngle(angle: float): float {
    angle % (2.0 * pi)
}

let sign(x: float): int {
    (x > 0.0) ? 1 : (x < 0.0) ? -1 : 0
}

let floor(x: float): float {
    let i = to_int(x) in
    (to_float(i) > x) ? to_float(i - 1) : to_float(i)
}

let ceil(x: float): float {
    let i = to_int(x) in
    (to_float(i) < x) ? to_float(i + 1) : to_float(i)
}

let round(x: float): float {
    floor(x + 0.5)
}

let rec sqrt_iter(x: float, guess: float): float {
    let new_guess = 0.5 * (guess + x / guess) in
    if abs(new_guess - guess) < 0.00001 then new_guess
    else sqrt_iter(x, new_guess)
}

let sqrt(x: float): float {
    if x < 0.0 then { panic("sqrt: negative input") 0.0 }
    else if x == 0.0 then 0.0
    else sqrt_iter(x, x / 2.0)
}

let rec cbrt_iter(x: float, guess: float): float {
    let new_guess = (2.0 * guess + x / (guess * guess)) / 3.0 in
    if abs(new_guess - guess) < 0.00001 then new_guess
    else cbrt_iter(x, new_guess)
}

let cbrt(x: float): float {
    if x == 0.0 then 0.0
    else if x > 0.0 then cbrt_iter(x, x / 3.0)
    else -cbrt_iter(-x, -x / 3.0)
}

let rec nthRoot_iter(x: float, n: float, guess: float): float {
    let new_guess = ((n - 1.0) * guess + x / pow(guess, n - 1.0)) / n in
    if abs(new_guess - guess) < 0.00001 then new_guess
    else nthRoot_iter(x, n, new_guess)
}

let nthRoot(x: float, n: float): float {
    if n == 0.0 then { panic("nthRoot: zero root") 0.0 }
    else if x == 0.0 then 0.0
    else if x > 0.0 then nthRoot_iter(x, n, x / n)
    else if (to_int(n) % 2 == 1) then -nthRoot_iter(-x, n, -x / n)
    else { panic("nthRoot: negative base with even root") 0.0 }
}

let rec exp_iter(x: float, n: int, terms: int, acc: float): float {
    if n >= terms then acc else {
        let term = pow(x, to_float(n)) / fact(n) in
        exp_iter(x, n + 1, terms, acc + term)
    }
}

let exp(x: float): float {
    exp_iter(x, 0, 30, 0.0)
}

let rec log_iter(x: float, guess: float): float {
    let new_guess = guess - (exp(guess) - x) / exp(guess) in
    if abs(new_guess - guess) < 0.00001 then new_guess
    else log_iter(x, new_guess)
}

let log(x: float): float {
    if x <= 0.0 then { panic("log: non-positive input") 0.0 }
    else log_iter(x, 1.0)
}

let log10(x: float): float {
    log(x) / log(10.0)
}

let log2(x: float): float {
    log(x) / log(2.0)
}

let logBase(x: float, base: float): float {
    if base <= 0.0 || base == 1.0 then { panic("logBase: invalid base") 0.0 }
    else log(x) / log(base)
}

let angle = pi / 4.0 in
let s = sin(angle, 15) in
let c = cos(angle, 15) in

let a0 = 0.0 in
let s0 = sin(a0, 15) in
let c0 = cos(a0, 15) in
 
let a1 = pi / 6.0 in 
let s1 = sin(a1, 15) in
let c1 = cos(a1, 15) in

let a2 = pi / 4.0 in
let s2 = sin(a2, 15) in
let c2 = cos(a2, 15) in

let a3 = pi / 3.0 in
let s3 = sin(a3, 15) in
let c3 = cos(a3, 15) in

let a4 = pi / 2.0 in
let s4 = sin(a4, 15) in
let c4 = cos(a4, 15) in

let a5 = pi in
let s5 = sin(a5, 15) in
let c5 = cos(a5, 15) in

let quad_angle = 3.0 * pi / 4.0 in
let sin_q = sin(quad_angle, 15) in
let cos_q = cos(quad_angle, 15) in

let rec gcd(a: int, b: int): int {
    if b == 0 then abs(to_float(a)) |> to_int
    else gcd(b, a % b)
}

let lcm(a: int, b: int): int {
    if a == 0 || b == 0 then 0
    else {
        let prod = abs(to_float(a * b)) in
        let prod_int = to_int(prod) in
        prod_int / gcd(a, b)
    }
}

let rec isPrimeCheck(n: int, i: int): bool {
    if i * i > n then true
    else if n % i == 0 then false
    else isPrimeCheck(n, i + 1)
}

let isPrime(n: int): bool {
    if n < 2 then false
    else if n == 2 then true
    else if n % 2 == 0 then false
    else isPrimeCheck(n, 3)
}

let rec isPrimeLimited(n: int, d: int): bool {
    if d * d > n then true
    else if n % d == 0 then false
    else isPrimeLimited(n, d + 1)
}

let rec primesUpTo(n: int, current: int): string {
    if current > n then "" 
    else if isPrimeLimited(current, 2) then to_string(current) ^ " " ^ primesUpTo(n, current + 1)
    else primesUpTo(n, current + 1)
}

let rec phi_iter(n: int, k: int, count: int): int {
    if k > n then count
    else if gcd(n, k) == 1 then phi_iter(n, k + 1, count + 1)
    else phi_iter(n, k + 1, count)
}

let phi(n: int): int {
    if n <= 0 then 0 else phi_iter(n, 1, 0)
}

let modExp(base: int, exp: int, m: int): int {
    let rec modExpIter(b: int, e: int, m: int, acc: int): int {
        if e == 0 then acc
        else if e % 2 == 0 then modExpIter((b * b) % m, e / 2, m, acc)
        else modExpIter(b, e - 1, m, (acc * b) % m)
    }
    modExpIter(base % m, exp, m, 1)
}

let rec extendedGCD(a: int, b: int): (int, int, int) {
    if b == 0 then (a, 1, 0)
    else {
        let res = extendedGCD(b, a % b) in
        let g = res[0] in
        let x1 = res[1] in
        let y1 = res[2] in
        (g, y1, x1 - (a / b) * y1)
    }
}

let modInverse(a: int, m: int): int {
    let res = extendedGCD(a, m) in
    let g = res[0] in
    let x = res[1] in
    if g != 1 then -1
    else ((x % m + m) % m)
}

let rec divisorCountIter(n: int, i: int, count: int): int {
    if i > n then count
    else if n % i == 0 then divisorCountIter(n, i + 1, count + 1)
    else divisorCountIter(n, i + 1, count)
}

let divisorCount(n: int): int {
    divisorCountIter(n, 1, 0)
}

let rec sumDivisorsIter(n: int, i: int, sum: int): int {
    if i > n then sum
    else if n % i == 0 then sumDivisorsIter(n, i + 1, sum + i)
    else sumDivisorsIter(n, i + 1, sum)
}

let sumDivisors(n: int): int {
    sumDivisorsIter(n, 1, 0)
}

let isPerfectNumber(n: int): bool {
    sumDivisors(n) - n == n
}

let nPr(n: int, r: int): float {
    if r > n || n < 0 || r < 0 then 0.0
    else fact(n) / fact(n - r)
}

let nCr(n: int, r: int): float {
    if r > n || n < 0 || r < 0 then 0.0
    else fact(n) / (fact(r) * fact(n - r))
}

let binomial(n: int, k: int): float {
    nCr(n, k)
}

let rec pascalRowIter(n: int, k: int): string {
    if k > n then ""
    else to_string(to_int(binomial(n, k))) ^ " " ^ pascalRowIter(n, k + 1)
}

let pascalRow(n: int): string {
    pascalRowIter(n, 0)
}

let powerSetSize(n: int): float {
    pow(2.0, to_float(n))
}

assert(abs(nPr(5, 2) - 20.0) < 0.001)
assert(abs(nCr(5, 2) - 10.0) < 0.001)
assert(abs(binomial(6, 3) - 20.0) < 0.001)

assert(pascalRow(0) == "1 ")
assert(pascalRow(4) == "1 4 6 4 1 ")

assert(abs(powerSetSize(3) - 8.0) < 0.001)

assert(gcd(54, 24) == 6)
assert(lcm(4, 6) == 12)

assert(isPrime(2))
assert(isPrime(13))
assert(not isPrime(21))

assert(primesUpTo(10, 2) == "2 3 5 7 ")

assert(phi(1) == 1)
assert(phi(9) == 6)

assert(modExp(2, 10, 1000) == 24)
assert(modInverse(3, 11) == 4)

assert(divisorCount(6) == 4)
assert(sumDivisors(6) == 12)
assert(isPerfectNumber(6))

assert(abs((s * s + c * c) - 1.0) < 0.01)

assert(abs((s0 * s0 + c0 * c0) - 1.0) < 0.02)

assert(abs((s1 * s1 + c1 * c1) - 1.0) < 0.02)

assert(abs((s2 * s2 + c2 * c2) - 1.0) < 0.02)

assert(abs((s3 * s3 + c3 * c3) - 1.0) < 0.02)

assert(abs((s4 * s4 + c4 * c4) - 1.0) < 0.02)

assert(abs((s5 * s5 + c5 * c5) - 1.0) < 0.02)

assert(sin_q > 0.0)
assert(cos_q < 0.0)

assert(abs((s * s + c * c) - 1.0) < 0.01)

assert(abs(pi - 3.141592653589) < 0.00001)
assert(abs(e - 2.718281828459) < 0.00001)

assert(abs(fact(0) - 1.0) < 0.00001)
assert(abs(fact(5) - 120.0) < 0.00001)

assert(abs(pow(2.0, 3.0) - 8.0) < 0.00001)

assert(abs(abs(-5.5) - 5.5) < 0.00001)
assert(abs(abs(3.0) - 3.0) < 0.00001)

assert(abs(degToRad(180.0) - pi) < 0.00001)
assert(abs(radToDeg(pi) - 180.0) < 0.00001)

assert(abs(sin(0.0, 10)) < 0.0001)
assert(abs(sin(pi / 2.0, 10) - 1.0) < 0.01)

assert(abs(cos(0.0, 10) - 1.0) < 0.0001)
assert(abs(cos(pi, 10) + 1.0) < 0.01)

assert(abs(tan(0.0, 10)) < 0.0001)

assert(abs(cot(pi / 4.0, 10) - 1.0) < 0.01)

assert(abs(sec(0.0, 10) - 1.0) < 0.01)
assert(abs(csc(pi / 2.0, 10) - 1.0) < 0.01)

assert(abs(arcsin(0.0, 10)) < 0.01)
assert(abs(arccos(1.0, 10)) < 0.01)

assert(abs(arctan(1.0, 20) - (pi / 4.0)) < 0.01)

assert(abs(wrapAngle(2.0 * pi) - 0.0) < 0.01)
assert(abs(wrapAngle(3.0 * pi) - pi) < 0.01)

assert(sign(10.0) == 1)
assert(sign(-5.0) == -1)
assert(sign(0.0) == 0)

assert(abs(floor(5.6) - 5.0) < 0.01)
assert(abs(floor(-2.3) - -3.0) < 0.01)

assert(abs(ceil(5.2) - 6.0) < 0.01)
assert(abs(ceil(-2.8) - -2.0) < 0.01)

assert(abs(round(5.6) - 6.0) < 0.01)
assert(abs(round(5.4) - 5.0) < 0.01)

assert(abs(sqrt(9.0) - 3.0) < 0.001)
assert(abs(sqrt(0.0) - 0.0) < 0.001)

assert(abs(cbrt(27.0) - 3.0) < 0.001)
assert(abs(cbrt(-8.0) + 2.0) < 0.001)

assert(abs(nthRoot(16.0, 4.0) - 2.0) < 0.001)
assert(abs(nthRoot(81.0, 2.0) - 9.0) < 0.001)
assert(abs(nthRoot(-125.0, 3.0) + 5.0) < 0.001)

assert(abs(exp(0.0) - 1.0) < 0.001)
assert(abs(exp(1.0) - e) < 0.01)

assert(abs(log(e) - 1.0) < 0.01)
assert(abs(log(1.0)) < 0.01)

assert(abs(log10(1000.0) - 3.0) < 0.01)
assert(abs(log10(10.0) - 1.0) < 0.01)

assert(abs(log2(8.0) - 3.0) < 0.01)
assert(abs(log2(2.0) - 1.0) < 0.01)
