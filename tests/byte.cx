-- $Id: tests/byte.cx $

-- $ basic test for bytes $
let a: byte = 'A'
assert(a == 'A')

let arr: []byte = {'H', 'e', 'l', 'l', 'o'}
assert(arr[0] == 'H')
assert(arr[4] == 'o')

let c: byte = 'c'
let d: byte = 'c'
assert(c == d)

let greeting: []byte = {'H', 'i'}
assert(greeting[0] == 'H')
assert(greeting[1] == 'i')
assert(to_string(greeting) == "Hi")

let empty: []byte = {}
assert(length(empty) == 0)

let byte_str: string = "Byte test"
let byte_arr: []byte = to_bytes(byte_str)
assert(length(byte_arr) == 9)
assert(byte_arr[0] == 'B')
assert(byte_arr[8] == 't')