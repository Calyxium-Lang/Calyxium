-- $Id: tests/ternay.cx $

-- $ basic tests for ternay $
let a, b: int = 10, 20

let max: int = (a > b) ? a : b
assert(max == 20)

let min: int = (a < b) ? a : b
assert(min == 10)

let check: string = (a == 10) ? "yes" : "no"
assert(check == "yes")

let nested: int = (a == 10) ? ((b == 20) ? 100 : 200) : 300
assert(nested == 100)