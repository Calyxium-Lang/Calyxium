-- $Id: tests/ternay.cx $

-- $ basic tests for ternay $
let a, b: int = 10, 20

let max: int = (a > b) ? a : b
assert(max == 20)

let min: int = (a < b) ? a : b
assert(min == 10)

let check: string = (a == 10) ? "yes" : "no"
assert(check == "yes")

let nested: int = (a == 10) ? ((b == 20) ? 100 : 200) : 300
assert(nested == 100)

let complex: string = (a > b) ? ((b < 30) ? "A" : "B") : ((a < 5) ? "C" : "D")
assert(complex == "D")

let condition: bool = true
let result: string = (condition) ? "Condition is true" : "Condition is false"
assert(result == "Condition is true")