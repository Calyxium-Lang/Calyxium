-- Id: tests/ternay.cx

-- basic tests for ternay

let a, b = 10, 20

let max = (a > b) ? a : b
assert(max == 20)

let min = (a < b) ? a : b
assert(min == 10)

let check = (a == 10) ? "yes" : "no"
assert(check == "yes")

let nested = (a == 10) ? ((b == 20) ? 100 : 200) : 300
assert(nested == 100)

let complex = (a > b) ? ((b < 30) ? "A" : "B") : ((a < 5) ? "C" : "D")
assert(complex == "D")

let condition = true
let result = (condition) ? "Condition is true" : "Condition is false"
assert(result == "Condition is true")